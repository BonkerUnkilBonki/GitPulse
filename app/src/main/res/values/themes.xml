<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GitPulse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Material 3 Expressive: bigger shapes everywhere -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.GitPulse.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GitPulse.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.GitPulse.Large</item>

        <!-- Material 3 Expressive: bolder, larger type scale -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.GitPulse.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.GitPulse.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.GitPulse.TitleMedium</item>

        <!-- Pill-shaped, taller buttons -->
        <item name="materialButtonStyle">@style/Widget.GitPulse.Button</item>
    </style>

    <!-- Expressive shape system -->
    <style name="ShapeAppearance.GitPulse.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.GitPulse.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.GitPulse.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">32dp</item>
    </style>

    <style name="ShapeAppearance.GitPulse.Pill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Expressive typography -->
    <style name="TextAppearance.GitPulse.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GitPulse.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.GitPulse.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.GitPulse.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.GitPulse.Pill</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Shape.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThemeOverlay.GitPulse.PitchBlack" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#141718</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#080A0A</item>
        <item name="colorSurfaceContainer">#0D0F0F</item>
        <item name="colorSurfaceContainerHigh">#141718</item>
        <item name="colorSurfaceContainerHighest">#1A1D1E</item>
        <item name="colorOutlineVariant">#202425</item>
    </style>

    <style name="Theme.GitPulse.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
    </style>

    <style name="Theme.GitPulse.BottomSheet.Black">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#141718</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#080A0A</item>
        <item name="colorSurfaceContainer">#0D0F0F</item>
        <item name="colorSurfaceContainerHigh">#141718</item>
        <item name="colorSurfaceContainerHighest">#1A1D1E</item>
        <item name="colorOutlineVariant">#202425</item>
    </style>
</resources>
